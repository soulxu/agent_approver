{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude session_start", "timeout": 10 } ] }
    ],
    "Setup": [
      { "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude setup", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude session_end", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude prompt", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude pretool", "timeout": 200 } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude posttool", "timeout": 10 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude posttool_fail", "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude precompact", "timeout": 10 } ] }
    ],
    "PostCompact": [
      { "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude postcompact", "timeout": 10 } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude subagent_start", "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude subagent_stop", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude stop", "timeout": 15 } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude stopfail", "timeout": 10 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "AGENT_APPROVER_AGENT=claude python3 __HOOK__ claude notification", "timeout": 10 } ] }
    ]
  }
}
