{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "python3 __HOOK__ shell", "timeout": 180 }
    ],
    "beforeMCPExecution": [
      { "command": "python3 __HOOK__ mcp", "timeout": 180 }
    ],
    "afterFileEdit": [
      { "command": "python3 __HOOK__ activity edit", "timeout": 5 }
    ],
    "beforeSubmitPrompt": [
      { "command": "python3 __HOOK__ activity prompt", "timeout": 5 }
    ],
    "stop": [
      { "command": "python3 __HOOK__ activity stop", "timeout": 5 }
    ]
  }
}
