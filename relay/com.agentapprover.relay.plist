<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd 配置: 开机/登录自动跑 relay. 安装见 install.sh (会把 __RELAY__ /
     __PYTHON__ 替换成真实路径再放到 ~/Library/LaunchAgents/). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentapprover.relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__RELAY__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
